{
  "name": "PDFCraft",
  "short_name": "PDFCraft",
  "description": "Free private PDF tools that run in your browser. No uploads.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f3f7f6",
  "theme_color": "#0f766e",
  "lang": "en",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/img/pdfcraft-icon.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/apple-touch-icon.png",
      "sizes": "180x180",
      "type": "image/png",
      "purpose": "any"
    }
  ]
}
